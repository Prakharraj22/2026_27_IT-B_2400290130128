# AI Career Intelligence Platform - Environment Configuration Example
# Copy this file to .env and adjust values for your local environment

NODE_ENV=development
PORT=3000

# ── Database & Cache ─────────────────────────────────────────────────────────
# PostgreSQL 15 connection string with pgvector extension enabled
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/career_intel?schema=auth"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/career_intel"
REDIS_URL="redis://localhost:6379"

# ── Security & Authentication ─────────────────────────────────────────────────
# Secrets MUST be at least 32 characters long in production
JWT_ACCESS_SECRET="super_secret_jwt_access_token_key_at_least_32_characters_long"
JWT_REFRESH_SECRET="super_secret_jwt_refresh_token_key_at_least_32_characters_long"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# Argon2id Hashing Parameters (OWASP recommended)
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# ── API Policies ─────────────────────────────────────────────────────────────
RATE_LIMIT_TTL=60000
RATE_LIMIT_MAX=100
RATE_LIMIT_AUTH_MAX=10
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://localhost:3001"

# ── AI Worker & Matching Configuration ────────────────────────────────────────
# Default embedding dimension (OpenAI text-embedding-ada-002 / text-embedding-3-small)
VECTOR_DIMENSION=1536
CACHE_TTL=3600
AI_WORKER_TIMEOUT_MS=5000
